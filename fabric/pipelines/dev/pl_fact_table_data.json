{
  "properties": {
    "activities": [
      {
        "name": "Lookup Fact Tables to Load",
        "description": "This lookup gets the list of fact tables that need to be processed, table is active, refresh frequency elapsed, and NO stored procedure is needed to process the data.",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.4:00:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": "select m.*, e.SuccessEMails, e.FailureEMails\nfrom ingestion_metadata m\n  join load_emails e\n     on replace(m.DataSource,'_Fact','') = e.DataSource\nwhere m.Active=1\nand m.DataSource in ('WH_Raw_Fact')\nand (DATEDIFF(MINUTE, isnull(m.LastLoadDateTime, '01/01/1900'), GETDATE()) / 60.0) >= m.RefreshFrequencyHours\nand m.ProcessingStoredProcedure is null\n\n",
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "firstRowOnly": false,
          "datasetSettings": {
            "annotations": [],
            "connectionSettings": {
              "name": "WH_Metadata",
              "properties": {
                "annotations": [],
                "type": "FabricSqlDatabase",
                "typeProperties": {
                  "workspaceId": "45bf33a4-63af-4924-b012-8d37e8b2d795",
                  "artifactId": "a50d7dee-853f-4780-a6ea-3ab163cad17e"
                },
                "externalReferences": {
                  "connection": "e7b4e8b4-bdca-4fac-a60a-6ba925e51986"
                }
              }
            },
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "typeProperties": {}
          }
        }
      },
