      {
        "name": "Check to Ensure no Duplicate SKs",
        "description": "Check for duplicate surrogate key values in the dimension tables prior to moving on to fact processing.",
        "type": "Lookup",
        "state": "Active",
        "dependsOn": [
          {
            "activity": "ForEach table to load No SP",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.4:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": "SELECT COUNT(1) FailedDims FROM vwDIM_SurrogateKey_DuplicateCheck",
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "firstRowOnly": true,
          "datasetSettings": {
            "annotations": [],
            "linkedService": {
              "name": "WH_Transform",
              "properties": {
                "annotations": [],
                "type": "DataWarehouse",
                "typeProperties": {
