                  "artifactId": "136eef95-87a9-44c9-8c39-74e2f6e1c5b9",
                  "workspaceId": "2b09b481-244a-470e-9797-6743fd25ca05"
                }
              }
            },
            "type": "DataWarehouseTable",
            "schema": [],
            "typeProperties": {}
          }
        }
      },
      {
        "name": "Check for FailedDim Duplicate SK Checks",
        "description": "If condition checking for duplicate surrogate keys",
        "type": "IfCondition",
        "state": "Active",
        "dependsOn": [
          {
            "activity": "Check to Ensure no Duplicate SKs",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@equals(coalesce(activity('Check to Ensure no Duplicate SKs').output.firstRow.FailedDims, 0), 0)",
            "type": "Expression"
          },
          "ifFalseActivities": [
            {
              "name": "Duplicate SKs found in Dim table load",
              "description": "Raise error if there are duplicates in the surrogate keys.",
              "type": "Fail",
              "state": "Active",
              "dependsOn": [],
              "typeProperties": {
                "message": "Duplicate SKs found in Dim table load.",
                "errorCode": "500"
              }
            }
          ],
          "ifTrueActivities": []
        }
      },
      {
        "name": "Failure Email Duplicate SKs",
        "description": "Send failure email if there are duplicate surrogate keys.",
        "type": "Office365Outlook",
        "state": "Active",
        "dependsOn": [
          {
            "activity": "Check for FailedDim Duplicate SK Checks",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "inputs": {
            "method": "post",
            "path": "/v2/Mail",
            "body": {
              "To": "@activity('Lookup Dim Tables to Load').output.value[0].FailureEMails",
              "Subject": "Dim Load Failure - Duplicate SKs",
              "Body": "<p>Dim Load Failure - Duplicate SKs</p>\n<p>Run the following query to determine offending dimensions:</p>\n<p>SELECT * FROM WH_transform.dbo.vwDIM_SurrogateKey_DuplicateCheck</p>\n<p><br></p>",
              "Sensitivity": "",
              "Importance": "Normal"
            }
          }
        }
      },
      {
        "name": "Duplicate SKs found in Dim table load_copy1",
        "description": "Raise error to calling environment if duplicate surrogate keys.",
        "type": "Fail",
        "state": "Active",
        "dependsOn": [
          {
            "activity": "Failure Email Duplicate SKs",
            "dependencyConditions": [
              "Completed"
            ]
          }
        ],
        "typeProperties": {
          "message": "Duplicate SKs found in Dim table load.",
          "errorCode": "500"
        }
