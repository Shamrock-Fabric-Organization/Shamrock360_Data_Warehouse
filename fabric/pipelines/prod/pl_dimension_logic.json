{
  "properties": {
    "activities": [
      {
        "name": "Lookup Dim Tables to Load",
        "description": "This lookup gets the list of dimension tables that need to be processed, table is active, refresh frequency elapsed, and a stored procedure is needed to process the data.",
        "type": "Lookup",
        "state": "Active",
        "dependsOn": [],
        "policy": {
          "timeout": "0.4:00:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": "select m.*, e.SuccessEMails, e.FailureEMails\nfrom ingestion_metadata m\n  join load_emails e\n     on m.DataSource = e.DataSource\nwhere m.Active=1\nand (DATEDIFF(MINUTE, isnull(m.LastLoadDateTime, '01/01/1900'), GETDATE()) / 60.0) >= m.RefreshFrequencyHours\nand m.ProcessingStoredProcedure is not null\n",
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "firstRowOnly": false,
          "datasetSettings": {
            "annotations": [],
            "connectionSettings": {
              "name": "WH_Metadata",
              "properties": {
                "annotations": [],
                "type": "FabricSqlDatabase",
                "typeProperties": {
                  "workspaceId": "2b09b481-244a-470e-9797-6743fd25ca05",
                  "artifactId": "b9b6942d-c7ec-4867-9205-d6ac6f414d1e"
                },
                "externalReferences": {
                  "connection": "e7b4e8b4-bdca-4fac-a60a-6ba925e51986"
                }
              }
            },
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "typeProperties": {}
          }
        }
      },
      {
        "name": "ForEach table to load",
        "description": "This loop processes each of the identified dimension tables.",
        "type": "ForEach",
        "state": "Active",
        "dependsOn": [
          {
            "activity": "Lookup Dim Tables to Load",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Lookup Dim Tables to Load').output.value",
            "type": "Expression"
          },
          "activities": [
