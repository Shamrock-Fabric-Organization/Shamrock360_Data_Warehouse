	measure 'Display Settings HTML' =
			
			VAR _Currency =
			    [Selected Display Currency]
			
			VAR _Weight =
			    [Selected Display Weight]
			
			VAR _LabelStyle =
			    "color:#191919;"
			
			VAR _CurrencyStyle =
			    "color:#85BB65;font-weight:600;"
			
			VAR _WeightStyle =
			    "color:#118DFF;font-weight:600;"
			
			RETURN
			    "<div style='font-family:Segoe UI,Arial,sans-serif;
			                 font-size:20px;
			                 line-height:22px;
			                 white-space:nowrap;
			                 text-align:right;'>"
			
			        & "<span style='" & _LabelStyle & "'>Currency: </span>"
			
			        & "<span style='" & _CurrencyStyle & "'>"
			        & _Currency
			        & "</span>"
			
			        & "<span style='" & _LabelStyle & "'>&nbsp;|&nbsp;Weight: </span>"
			
			        & "<span style='" & _WeightStyle & "'>"
			        & _Weight
			        & "</span>"
			
			    & "</div>"
		lineageTag: 324d7d2a-58cf-4ff0-b7cb-2a6088de0f5e

	measure 'Global Filter Summary HTML' =
			
			VAR _EntityFilters =
			    FILTERS ( 'Dim_Legal_Entity'[CMPNY] )
			
			VAR _EmployeeFilters =
			    FILTERS ( 'Dim_Employee'[Employee_Name] )
			
			VAR _CountryFilters =
			    FILTERS ( 'Dim_Address'[Country] )
			
			VAR _IndustryFilters =
			    FILTERS ( 'DIM_MarketSegmentation'[Industry] )
			
			// Legal entity selections
			VAR _Entity =
			    IF (
			        ISFILTERED ( 'Dim_Legal_Entity'[CMPNY] ),
			        IF (
			            COUNTROWS ( _EntityFilters ) <= 2,
			            CONCATENATEX (
			                _EntityFilters,
			                'Dim_Legal_Entity'[CMPNY],
			                ", ",
			                'Dim_Legal_Entity'[CMPNY],
			                ASC
			            ),
			            COUNTROWS ( _EntityFilters ) & " selected"
			        ),
			        "All"
			    )
			
			
			// Escape special HTML characters in dynamic values
			VAR _EntityHTML =
			    SUBSTITUTE (
			        SUBSTITUTE ( SUBSTITUTE ( _Entity, "&", "&amp;" ), "<", "&lt;" ),
			        ">", "&gt;"
			    )
			
			
			// Formatting
			VAR _LabelStyle =
			    "color:#191919;"
			
			VAR _ValueStyle =
			    "color:#08911f;font-weight:600;"
			
			VAR _Separator =
			    "<span style='color:#191919;'>&nbsp;|&nbsp;</span>"
			
			RETURN
			    "<div style='font-family:Segoe UI,Arial,sans-serif;
			                 font-size:20px;
			                 line-height:22px;
			                 text-align:left;'>"
			
			        & "<span style='white-space:nowrap;'>"
			        & "<span style='" & _LabelStyle & "'>Entity: </span>"
			        & "<span style='" & _ValueStyle & "'>" & _EntityHTML & "</span>"
			        & "</span>"
			
			
			    & "</div>"
		lineageTag: aa689eaf-0e2b-4537-a729-47f57715e959

	measure 'Profitability Y-Axis Unit' =
			
			VAR _Currency =
			    SWITCH (
			        [Selected Display Currency],
			        "USD", "$",
			        "EUR", "€",
			        "CNY", "¥",
			        "$"
			    )
			
			VAR _Weight =
			    SWITCH (
			        [Selected Display Weight],
			        "LBs", "lb",
			        "KGs", "kg",
			        "lb"
			    )
			
			RETURN
			    _Currency & "/" & _Weight
		lineageTag: b8b0223d-b7f8-41df-8a70-14347f826eb8

	measure 'Profitability Chart Title' =
			
			VAR _Weight =
			    SWITCH (
			        [Selected Display Weight],
			        "LBs", "lb",
			        "KGs", "kg",
			        "lb"
			    )
			
			RETURN
			    "Margin % and Profitability per " & _Weight
		lineageTag: 886e719f-2dd2-47c3-b0a4-f6d3e46d8319

	measure 'Cost Settings Valid' =
			
			VAR _Company =
			    CALCULATE (
			        SELECTEDVALUE ( 'Dim_Legal_Entity'[CMPNY] ),
			        ALLSELECTED ( 'Dim_Legal_Entity' )
			    )
			
			VAR _Currency =
			    SELECTEDVALUE (
			        'Dim_ReportCurrencyHelper'[Report_Currency_Code]
			    )
			
			VAR _Weight =
			    SELECTEDVALUE (
			        'Dim_QuantityUnitHelper'[Quantity_Unit_Code]
			    )
			
			VAR _ValidUS =
			    _Company = "101"
			        && _Currency = "USD"
			        && _Weight = "LBs"
			
			VAR _ValidBelgium =
			    _Company = "301"
			        && _Currency = "EUR"
			        && _Weight = "KGs"
			
			RETURN
			    IF ( _ValidUS || _ValidBelgium, 1, 0 )
		formatString: 0
		lineageTag: 73578935-36b3-4406-8855-8a48ee2562d6

	measure 'Cost Settings Message' =
			
			IF (
			    [Cost Settings Valid] = 1,
			    "Standard-cost settings match the selected company's currency and weight basis.",
			    "Standard-cost results are not valid for these settings. "
			        & "Select one company: 101 with USD and LBs, "
			        & "or 301 with EUR and KGs."
			)
		lineageTag: 4f3cda63-2306-4c75-922b-4d93bdcecebf

	measure 'Cost Settings Message Color' =
			
			IF (
			    [Cost Settings Valid] = 1,
			    "#191919",   -- Valid settings: dark gray
			    "#C62828"    -- Invalid settings: crimson red
			)
		lineageTag: 10bf33fc-8284-439e-87dd-b8145bc4840f

	measure 'Revenue PVM Invoice Coverage Rows' =
			
			CALCULATE (
			    CALCULATE (
			        [Total Invoices],
			
			        -- Exclude the preloaded invoices without a usable product.
			        KEEPFILTERS (
			            'Dim_Product'[Product_ID] <> "Unknown"
			                && NOT ISBLANK (
			                    'Dim_Product'[Product_ID]
			                )
			        )
			    ),
			
			    -- Determine coverage for the entity, not the current product
			    -- or market-segmentation selection.
			    REMOVEFILTERS ( 'Dim_Product' ),
			    REMOVEFILTERS ( 'Dim_MarketSegmentation' )
			)
		formatString: 0
		lineageTag: 21ed0dcd-e773-432d-9faf-ebebd0d91926

	measure 'Base GL - AcctCurrAmt' =
			
			SWITCH (
			    [Selected Display Currency],
			    "USD", SUM ( Fact_GeneralLedger[accountingcurrencyamount_USD] ),
			    "EUR", SUM ( Fact_GeneralLedger[accountingcurrencyamount_EUR] ),
			    "CNY", SUM ( Fact_GeneralLedger[accountingcurrencyamount_CNY] ),
			    BLANK ()
			)
		lineageTag: e21c178b-61ac-4cf8-b383-2cee8c910ea4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

