table 'Candidate Product Family'
	lineageTag: b9a8e96e-c1b1-4689-8ee1-0a6f85dfd766

	measure 'Selected Relabel Product Family' =
			
			VAR Ready =
			    [Candidate Detail Context Is Valid] = 1
			
			VAR Families =
			    VALUES (
			        'Candidate Product Family'[RelabelProduct]
			    )
			
			VAR FamilyCount =
			    COUNTROWS ( Families )
			
			RETURN
			IF (
			    NOT Ready,
			    BLANK (),
			    SWITCH (
			        TRUE (),
			        FamilyCount = 0, BLANK (),
			        FamilyCount = 1,
			            MAXX (
			                Families,
			                'Candidate Product Family'[RelabelProduct]
			            ),
			        FORMAT ( FamilyCount, "0" ) & " product families"
			    )
			)
		lineageTag: 1b74f1a9-d846-438b-b996-7019968456bd

	measure 'Selected Packaging SKU Count' =
			
			IF (
			    [Candidate Detail Context Is Valid] = 1,
			    SUM (
			        'Candidate Product Family'[SKUCount]
			    )
			)
		formatString: 0
		lineageTag: 18dd102c-3eba-4e56-ab52-c6cf70cceedc

	measure 'Selected Example Product ID' =
			
			VAR Ready =
			    [Candidate Detail Context Is Valid] = 1
			
			VAR FamilyCount =
			    DISTINCTCOUNT (
			        'Candidate Product Family'[RelabelProduct]
			    )
			
			RETURN
			IF (
			    Ready,
			    IF (
			        FamilyCount = 1,
			        SELECTEDVALUE (
			            'Candidate Product Family'[ExampleProductID]
			        ),
			        "See product list"
			    )
			)
		lineageTag: 46f4a174-f165-4ee0-aeae-9a3576a5f0c8

	measure 'Candidate Detail Message' =
			
			SWITCH (
			    TRUE (),
			    [Source Selection Is Valid] <> 1,
			        "Select a quality order or batch.",
			    [Candidate Detail Context Is Valid] <> 1,
			        "Select one candidate test group.",
			    "Candidate test group selected."
			)
		lineageTag: 0e707a1f-d355-4f58-8d26-5a09e807a0ac

