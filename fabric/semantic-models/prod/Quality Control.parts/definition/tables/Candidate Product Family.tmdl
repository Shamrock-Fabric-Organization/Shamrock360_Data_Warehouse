	column UsedCommercialNameFlag
		dataType: int64
		formatString: 0
		lineageTag: c9a370e3-0f88-4722-b508-5aebd3d04f4f
		summarizeBy: sum
		sourceColumn: UsedCommercialNameFlag

		annotation SummarizationSetBy = Automatic

	partition 'Candidate Product Family' = m
		mode: import
		source =
				let
				  Source = Sql.Database("efrhfadk6eru3b7hpy4j3xs2eu-qg2ask2keqhepf4xm5b72jokau.datawarehouse.fabric.microsoft.com", "WH_Curated", [Query = "WITH ResolvedProducts AS#(lf)(#(lf)    SELECT#(lf)        g.TestGroupKey,#(lf)        le.Legal_EntityKey,#(lf)        g.CMPNY,#(lf)        g.testgroupid,#(lf)#(lf)        COALESCE(#(lf)            NULLIF(TRIM(p.Commercial_Name), ''),#(lf)            NULLIF(TRIM(p.Product_Name), ''),#(lf)            p.Product_ID#(lf)        ) AS RelabelProduct,#(lf)#(lf)        p.Product_ID,#(lf)        p.Product_Name,#(lf)#(lf)        CASE#(lf)            WHEN NULLIF(TRIM(p.Commercial_Name), '') IS NOT NULL#(lf)                THEN 1#(lf)            ELSE 0#(lf)        END AS UsedCommercialNameFlag#(lf)#(lf)    FROM dbo.mtbl_EDW_Dim_Product AS p#(lf)#(lf)    INNER JOIN dbo.mtbl_EDW_Dim_TestGroup AS g#(lf)        ON p.CMPNY = g.CMPNY#(lf)        AND p.testgroupid = g.testgroupid#(lf)        AND g.RecordStatus = 1#(lf)#(lf)    INNER JOIN dbo.mtbl_EDW_Dim_Legal_Entity AS le#(lf)        ON g.CMPNY = le.CMPNY#(lf)        AND le.RecordStatus = 1#(lf)#(lf)    WHERE#(lf)        p.Record_Status = 1#(lf)        AND p.testgroupid IS NOT NULL#(lf))#(lf)#(lf)SELECT#(lf)    TestGroupKey,#(lf)    Legal_EntityKey,#(lf)    CMPNY,#(lf)    testgroupid,#(lf)    RelabelProduct,#(lf)#(lf)    COUNT(DISTINCT Product_ID) AS SKUCount,#(lf)    MIN(Product_ID) AS ExampleProductID,#(lf)    MIN(Product_Name) AS ExampleProductName,#(lf)    MAX(UsedCommercialNameFlag) AS UsedCommercialNameFlag#(lf)#(lf)FROM ResolvedProducts#(lf)#(lf)GROUP BY#(lf)    TestGroupKey,#(lf)    Legal_EntityKey,#(lf)    CMPNY,#(lf)    testgroupid,#(lf)    RelabelProduct;"])
				in
				  Source

	annotation PBI_ResultType = Exception


