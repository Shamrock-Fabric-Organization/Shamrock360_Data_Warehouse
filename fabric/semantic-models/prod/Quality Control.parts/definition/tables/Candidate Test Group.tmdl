	partition 'Candidate Test Group' = m
		mode: import
		source =
				let
				  Source = Sql.Database("efrhfadk6eru3b7hpy4j3xs2eu-qg2ask2keqhepf4xm5b72jokau.datawarehouse.fabric.microsoft.com", "WH_Curated", [Query = "WITH CurrentGroups AS#(lf)(#(lf)    SELECT#(lf)        g.TestGroupKey,#(lf)        le.Legal_EntityKey,#(lf)        g.CMPNY,#(lf)        g.testgroupid,#(lf)        g.TestGroupDescription,#(lf)        g.IsDestructive,#(lf)        g.RecordStatus#(lf)#(lf)    FROM dbo.mtbl_EDW_Dim_TestGroup AS g#(lf)#(lf)    INNER JOIN dbo.mtbl_EDW_Dim_Legal_Entity AS le#(lf)        ON g.CMPNY = le.CMPNY#(lf)        AND le.RecordStatus = 1#(lf)#(lf)    WHERE#(lf)        g.RecordStatus = 1#(lf)),#(lf)#(lf)RequirementCounts AS#(lf)(#(lf)    SELECT#(lf)        d.TestGroupKey,#(lf)        COUNT(DISTINCT UPPER(TRIM(d.testid))) AS RequiredTestCount#(lf)#(lf)    FROM dbo.mtbl_EDW_Fact_TestGroupDetails AS d#(lf)#(lf)    INNER JOIN CurrentGroups AS g#(lf)        ON d.TestGroupKey = g.TestGroupKey#(lf)#(lf)    WHERE#(lf)        d.testid IS NOT NULL#(lf)#(lf)    GROUP BY#(lf)        d.TestGroupKey#(lf)),#(lf)#(lf)ResolvedProductFamilies AS#(lf)(#(lf)    SELECT#(lf)        g.TestGroupKey,#(lf)#(lf)        COALESCE(#(lf)            NULLIF(TRIM(p.Commercial_Name), ''),#(lf)            NULLIF(TRIM(p.Product_Name), ''),#(lf)            p.Product_ID#(lf)        ) AS RelabelProduct#(lf)#(lf)    FROM dbo.mtbl_EDW_Dim_Product AS p#(lf)#(lf)    INNER JOIN CurrentGroups AS g#(lf)        ON p.CMPNY = g.CMPNY#(lf)        AND p.testgroupid = g.testgroupid#(lf)#(lf)    WHERE#(lf)        p.Record_Status = 1#(lf)        AND p.testgroupid IS NOT NULL#(lf)),#(lf)#(lf)ProductFamilyCounts AS#(lf)(#(lf)    SELECT#(lf)        TestGroupKey,#(lf)        COUNT(DISTINCT RelabelProduct) AS ProductFamilyCount#(lf)#(lf)    FROM ResolvedProductFamilies#(lf)#(lf)    GROUP BY#(lf)        TestGroupKey#(lf))#(lf)#(lf)SELECT#(lf)    g.TestGroupKey,#(lf)    g.Legal_EntityKey,#(lf)    g.CMPNY,#(lf)    g.testgroupid,#(lf)    g.TestGroupDescription,#(lf)    g.IsDestructive,#(lf)    g.RecordStatus,#(lf)#(lf)    COALESCE(r.RequiredTestCount, 0) AS RequiredTestCount,#(lf)    COALESCE(p.ProductFamilyCount, 0) AS ProductFamilyCount#(lf)#(lf)FROM CurrentGroups AS g#(lf)#(lf)LEFT JOIN RequirementCounts AS r#(lf)    ON g.TestGroupKey = r.TestGroupKey#(lf)#(lf)LEFT JOIN ProductFamilyCounts AS p#(lf)    ON g.TestGroupKey = p.TestGroupKey;"])
				in
				  Source

	annotation PBI_ResultType = Exception


