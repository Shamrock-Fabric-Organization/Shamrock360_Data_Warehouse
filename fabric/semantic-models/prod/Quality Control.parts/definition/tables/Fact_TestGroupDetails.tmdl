table Fact_TestGroupDetails
	lineageTag: 62eb7395-fea8-4de7-925e-6360e7761cf1
	sourceLineageTag: [dbo].[mtbl_EDW_Fact_TestGroupDetails]

	measure 'Test Group Selection Count' =
			
			CALCULATE (
			    DISTINCTCOUNT (
			        'Dim_TestGroup'[TestGroupKey]
			    ),
			    ALLSELECTED (
			        'Dim_TestGroup'
			    )
			)
		formatString: 0
		lineageTag: e63c4dcc-f614-4273-8db6-182c5c97b8ed

		changedProperty = Name

	measure 'Show Test Group Details' =
			
			IF (
			    [Test Group Selection Count] = 1,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 4f26d08a-83ee-4478-bee8-eda680bbdcde

		changedProperty = Name

