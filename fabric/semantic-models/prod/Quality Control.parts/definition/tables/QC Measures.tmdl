table 'QC Measures'
	lineageTag: ff91c694-d152-46eb-91c2-886cc9889c3a

	measure 'Source Order Selection Count' =
			
			IF (
			    [Source Search Is Applied] = 1,
			    DISTINCTCOUNT ( 'Source Quality Order'[SourceOrderKey] )
			)
		formatString: 0
		lineageTag: ddda5c84-0a51-43e8-aed3-46a51cdfb115

	measure 'Source Quality Order ID' =
			
			IF (
			    [Source Order Selection Count] = 1,
			    SELECTEDVALUE ( 'Source Quality Order'[qualityorderid] )
			)
		lineageTag: d63320f6-f405-4714-a607-3ce5a1f1d776

	measure 'Source Order Status' =
			
			IF (
			    [Source Order Selection Count] = 1,
			    SELECTEDVALUE ( 'Source Quality Order'[QualityOrderStatus] )
			)
		lineageTag: 30bb52c2-f88e-4139-8719-60f41a73eeee

	measure 'Source Selection Message' =
			
			VAR SearchApplied =
			    [Source Search Is Applied]
			VAR SelectionCount =
			    [Source Order Selection Count]
			VAR Statuss =
			    [Source Order Status]
			VAR BatchFiltered =
			    ISFILTERED ( 'Source Quality Order'[Batch Number] )
			VAR SerialFiltered =
			    ISFILTERED ( 'Source Quality Order'[Serial Number] )
			RETURN
			SWITCH (
			    TRUE (),
			    SearchApplied = 0,
			        "Select a quality order or batch.",
			    SelectionCount = 0,
			        "No quality order matches the current selection.",
			    SelectionCount = 1 && Statuss = "Open",
			        "The selected quality order is Open and cannot yet be evaluated.",
			    SelectionCount = 1,
			        "Source quality order selected.",
			    SelectionCount > 1 && BatchFiltered && NOT SerialFiltered,
			        "This batch has multiple quality orders. Select a serial number.",
			    SelectionCount > 1,
			        "The selection resolves to multiple quality orders.",
			    "Review the source selection."
			)
		lineageTag: 3b3c428a-8447-4c5c-a65c-c8f77fef6514

	measure 'Source Selection Is Valid' =
			
			IF (
			    [Source Search Is Applied] = 1
			        && [Source Order Selection Count] = 1
			        && [Source Order Status] <> "Open",
			    1,
			    0
			)
		formatString: 0
		lineageTag: 537452ee-9e07-4a06-a3d5-30d8dc311c49

	measure 'Source Search Is Applied' =
			
			INT (
			    ISFILTERED ( 'Source Quality Order'[qualityorderid] )
			        || ISFILTERED ( 'Source Quality Order'[Batch Number] )
			        || ISFILTERED ( 'Source Quality Order'[Serial Number] )
			)
		formatString: 0
		lineageTag: cca0c655-8716-415e-be58-405fd680e18f

	measure 'Source Order Key' =
			
			IF (
			    [Source Order Selection Count] = 1,
			    SELECTEDVALUE ( 'Source Quality Order'[SourceOrderKey] )
			)
		lineageTag: 6934e7c9-679c-495f-92ce-2c765bed37db

	measure 'Source Product' =
			
			SELECTEDVALUE ( 'Source Quality Order'[Product_Name] )
		lineageTag: 325504b2-0db4-4886-8d9a-f4df57def4ae

	measure 'Source Commercial Name' =
			
			SELECTEDVALUE ( 'Source Quality Order'[Source Commercial Name] )
		lineageTag: 284521b9-2a18-478b-8856-15b4d29eca8b

	measure 'Source Original Test Group' =
			
			SELECTEDVALUE (
			    'Source Quality Order'[OriginalTestGroupDescription]
			)
		lineageTag: 20229192-c136-4ad9-8b42-86429ec75edc

	measure 'Source Test Count' =
			
			IF (
			    [Source Selection Is Valid] = 1,
			    DISTINCTCOUNT (
			        'Quality Order Test Evidence'[TestIdNormalized]
			    )
			)
		formatString: 0
		lineageTag: 2abf753a-3a14-4e56-a7f3-a2567dfb08e9

	measure 'Source Skipped Test Count' =
			
			IF (
			    [Source Selection Is Valid] = 1,
			    CALCULATE (
			        DISTINCTCOUNT (
			            'Quality Order Test Evidence'[TestIdNormalized]
			        ),
			        'Quality Order Test Evidence'[IsSkipped] = 1
			    )
			)
		formatString: 0
		lineageTag: dea02eb5-6c12-4af8-9950-4eab6961ee6b

	measure 'Candidate Required Test Count' =
			
			MAX ( 'Candidate Test Group'[RequiredTestCount] )
		formatString: 0
		lineageTag: 460870d5-4980-4c94-8cbc-3b27c2866c19

	measure 'Candidate Product Family Count' =
			
			MAX ( 'Candidate Test Group'[ProductFamilyCount] )
		formatString: 0
		lineageTag: b9aad90a-ec46-4f96-8469-5880cb7a2894

	measure 'Matched Required Test Count' =
			
			VAR SourceTests =
			    SELECTCOLUMNS (
			        VALUES (
			            'Quality Order Test Evidence'[TestIdNormalized]
			        ),
			        "__TestID",
			            'Quality Order Test Evidence'[TestIdNormalized] & ""
			    )
			
			VAR RequiredTests =
			    SELECTCOLUMNS (
			        VALUES (
			            'Test Group Requirement'[TestIdNormalized]
			        ),
			        "__TestID",
			            'Test Group Requirement'[TestIdNormalized] & ""
			    )
			
			RETURN
			IF (
			    [Source Selection Is Valid] = 1,
			    COUNTROWS (
			        INTERSECT (
			            SourceTests,
			            RequiredTests
			        )
			    )
			)
		formatString: 0
		lineageTag: 048d9939-1465-498d-9462-83ec45effc15

	measure 'Missing Required Test Count' =
			
			MAX (
			    0,
			    [Candidate Required Test Count]
			        - [Matched Required Test Count]
			)
		formatString: 0
		lineageTag: 976b17e1-3629-40a8-9ca7-e8ee06b8c22c

	measure 'Extra Source Test Count' =
			
			MAX (
			    0,
			    [Source Test Count]
			        - [Matched Required Test Count]
			)
		formatString: 0
		lineageTag: 9fe8d8fb-2f22-4b04-ac8c-5b9706537867

	measure 'Candidate Coverage Type' =
			
			VAR Matched =
			    [Matched Required Test Count]
			VAR Missing =
			    [Missing Required Test Count]
			VAR Extra =
			    [Extra Source Test Count]
			RETURN
			SWITCH (
			    TRUE (),
			    [Source Selection Is Valid] <> 1, BLANK (),
			    Matched = 0, "No useful match",
			    Missing = 0 && Extra = 0, "Exact coverage",
			    Missing = 0 && Extra > 0, "Overrepresented",
			    Missing > 0 && Matched > 0, "Underrepresented",
			    "Review"
			)
		lineageTag: 336f20e6-bf45-4cc5-a25d-f08292683686

	measure 'Candidate Group Same Company' =
			
			VAR SourceLegalEntity =
			    SELECTEDVALUE (
			        'Source Quality Order'[Legal_EntityKey]
			    )
			VAR CandidateLegalEntity =
			    SELECTEDVALUE (
			        'Candidate Test Group'[Legal_EntityKey]
			    )
			RETURN
			IF (
			    [Source Selection Is Valid] = 1
			        && NOT ISBLANK ( CandidateLegalEntity )
			        && SourceLegalEntity = CandidateLegalEntity,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 4175351f-f722-4559-9a95-986ef22598e1

	measure 'Candidate Group Visible' =
			
			VAR SelectedView =
			    SELECTEDVALUE (
			        'Candidate View'[Candidate View],
			        "Complete coverage"
			    )
			VAR Matched =
			    [Matched Required Test Count]
			VAR Missing =
			    [Missing Required Test Count]
			VAR Extra =
			    [Extra Source Test Count]
			VAR HasProducts =
			    [Candidate Product Family Count] > 0
			VAR HasRequirements =
			    [Candidate Required Test Count] > 0
			RETURN
			IF (
			    [Source Selection Is Valid] <> 1
			        || [Candidate Group Same Company] <> 1
			        || NOT HasProducts
			        || NOT HasRequirements,
			    0,
			    SWITCH (
			        TRUE (),
			        SelectedView = "Complete coverage"
			            && Missing = 0, 1,
			
			        SelectedView = "Exact coverage"
			            && Missing = 0
			            && Extra = 0, 1,
			
			        SelectedView = "Overrepresented"
			            && Missing = 0
			            && Extra > 0, 1,
			
			        SelectedView = "Underrepresented"
			            && Missing > 0
			            && Matched > 0, 1,
			
			        SelectedView = "Any overlap"
			            && Matched > 0, 1,
			
			        SelectedView = "All current groups", 1,
			
			        0
			    )
			)
		formatString: 0
		lineageTag: 4d0a71f0-06de-474a-a30c-56e0645e1700

	measure 'Candidate Group Decision Code' =
			
			VAR SourceIsValid =
			    [Source Selection Is Valid] = 1
			VAR SameCompany =
			    [Candidate Group Same Company] = 1
			VAR RequiredCount =
			    [Candidate Required Test Count]
			
			RETURN
			IF (
			    NOT SourceIsValid
			        || NOT SameCompany
			        || RequiredCount = 0,
			    BLANK (),
			
			    VAR SourceRows =
			        SELECTCOLUMNS (
			            'Quality Order Test Evidence',
			
			            "__JoinTestID",
			                'Quality Order Test Evidence'[TestIdNormalized] & "",
			
			            "__SourceExists", 1,
			
			            "__SourceSkipped",
			                'Quality Order Test Evidence'[IsSkipped],
			
			            "__SourceConflict",
			                'Quality Order Test Evidence'[SourceConflictFlag],
			
			            "__SourceClass",
			                'Quality Order Test Evidence'[SourceTestClass],
			
			            "__SourceUnit",
			                COALESCE (
			                    'Quality Order Test Evidence'[SourceUnitNormalized],
			                    ""
			                ),
			
			            "__SourceNumeric",
			                'Quality Order Test Evidence'[SourceNumericResult],
			
			            "__SourceOutcome",
			                COALESCE (
			                    'Quality Order Test Evidence'[SourceOutcomeNormalized],
			                    ""
			                )
			        )
			
			    VAR TargetRows =
			        SELECTCOLUMNS (
			            'Test Group Requirement',
			
			            "__JoinTestID",
			                'Test Group Requirement'[TestIdNormalized] & "",
			
			            "__RequirementKey",
			                'Test Group Requirement'[RequirementKey],
			
			            "__TargetConflict",
			                'Test Group Requirement'[RequirementConflictFlag],
			
			            "__TargetClass",
			                'Test Group Requirement'[TargetTestClass],
			
			            "__TargetUnit",
			                COALESCE (
			                    'Test Group Requirement'[TargetUnitNormalized],
			                    ""
			                ),
			
			            "__TargetLower",
			                'Test Group Requirement'[lowerlimit],
			
			            "__TargetUpper",
			                'Test Group Requirement'[upperlimit]
			        )
			
			    VAR JoinedRows =
			        NATURALLEFTOUTERJOIN (
			            TargetRows,
			            SourceRows
			        )
			
			    VAR EvaluatedRows =
			        ADDCOLUMNS (
			            JoinedRows,
			
			            "__EvaluationCode",
			
			            VAR SourceExists =
			                COALESCE ( [__SourceExists], 0 ) = 1
			
			            VAR SourceSkipped =
			                COALESCE ( [__SourceSkipped], 0 ) = 1
			
			            VAR SourceConflict =
			                COALESCE ( [__SourceConflict], 0 ) = 1
			
			            VAR TargetConflict =
			                COALESCE ( [__TargetConflict], 0 ) = 1
			
			            VAR SourceClass =
			                COALESCE ( [__SourceClass], "UNSUPPORTED" )
			
			            VAR TargetClass =
			                COALESCE ( [__TargetClass], "UNSUPPORTED" )
			
			            VAR SourceUnit =
			                COALESCE ( [__SourceUnit], "" )
			
			            VAR TargetUnit =
			                COALESCE ( [__TargetUnit], "" )
			
			            VAR SourceNumeric =
			                [__SourceNumeric]
			
			            VAR SourceOutcome =
			                COALESCE ( [__SourceOutcome], "" )
			
			            VAR TargetLower =
			                [__TargetLower]
			
			            VAR TargetUpper =
			                [__TargetUpper]
			
			            VAR RequirementKey =
			                [__RequirementKey]
			
			            VAR HasLower =
			                NOT ISBLANK ( TargetLower )
			
			            VAR HasUpper =
			                NOT ISBLANK ( TargetUpper )
			
			            VAR NumericOutsideRange =
			                ( HasLower && SourceNumeric < TargetLower )
			                    || ( HasUpper && SourceNumeric > TargetUpper )
			
			            VAR MappedOutcomeStatus =
			                IF (
			                    TargetClass = "OPTION"
			                        && SourceExists
			                        && NOT SourceSkipped
			                        && SourceOutcome <> "",
			
			                    CALCULATE (
			                        SELECTEDVALUE (
			                            'Test Group Outcome'[OutcomeStatusNormalized]
			                        ),
			
			                        REMOVEFILTERS (
			                            'Test Group Outcome'
			                        ),
			
			                        TREATAS (
			                            { RequirementKey },
			                            'Test Group Outcome'[RequirementKey]
			                        ),
			
			                        TREATAS (
			                            { SourceOutcome },
			                            'Test Group Outcome'[OutcomeIdNormalized]
			                        )
			                    )
			                )
			
			            RETURN
			                SWITCH (
			                    TRUE (),
			
			                    NOT SourceExists, 1,
			
			                    SourceSkipped, 1,
			
			                    SourceConflict || TargetConflict, 1,
			
			                    NOT (
			                        SourceClass IN { "OPTION", "NUMERIC" }
			                    ), 1,
			
			                    NOT (
			                        TargetClass IN { "OPTION", "NUMERIC" }
			                    ), 1,
			
			                    SourceClass <> TargetClass, 1,
			
			                    TargetClass = "NUMERIC"
			                        && SourceUnit <> TargetUnit, 1,
			
			                    TargetClass = "NUMERIC"
			                        && ISBLANK ( SourceNumeric ), 1,
			
			                    TargetClass = "NUMERIC"
			                        && NOT ( HasLower || HasUpper ), 1,
			
			                    TargetClass = "NUMERIC"
			                        && NumericOutsideRange, 2,
			
			                    TargetClass = "NUMERIC", 0,
			
			                    TargetClass = "OPTION"
			                        && SourceOutcome = "", 1,
			
			                    TargetClass = "OPTION"
			                        && MappedOutcomeStatus = "PASS", 0,
			
			                    TargetClass = "OPTION"
			                        && MappedOutcomeStatus = "FAIL", 2,
			
			                    1
			                )
			        )
			
			    VAR FailedTests =
			        COUNTROWS (
			            FILTER (
			                EvaluatedRows,
			                [__EvaluationCode] = 2
			            )
			        )
			
			    VAR IncompleteTests =
			        COUNTROWS (
			            FILTER (
			                EvaluatedRows,
			                [__EvaluationCode] = 1
			            )
			        )
			
			    RETURN
			        SWITCH (
			            TRUE (),
			            FailedTests > 0, 3,
			            IncompleteTests > 0, 2,
			            1
			        )
			)
		formatString: 0
		lineageTag: 7547306f-25b3-4573-97f8-0afab9ad00b0

	measure 'Candidate Group Decision' =
			
			SWITCH (
			    [Candidate Group Decision Code],
			    1, "ELIGIBLE",
			    2, "NEEDS TESTING",
			    3, "NOT ELIGIBLE",
			    BLANK ()
			)
		lineageTag: bcff4fd6-5a1d-414c-aa53-47dee57163c5

	measure 'Source Test Row Count' =
			
			VAR CurrentTest =
			    SELECTEDVALUE (
			        'Test Group Requirement'[TestIdNormalized]
			    )
			RETURN
			IF (
			    [Source Selection Is Valid] = 1
			        && NOT ISBLANK ( CurrentTest ),
			
			    CALCULATE (
			        COUNTROWS (
			            'Quality Order Test Evidence'
			        ),
			
			        TREATAS (
			            { CurrentTest },
			            'Quality Order Test Evidence'[TestIdNormalized]
			        )
			    )
			)
		formatString: 0
		lineageTag: 0ae4fe22-8c3e-4cfe-8321-7ffe42d9e9b6

