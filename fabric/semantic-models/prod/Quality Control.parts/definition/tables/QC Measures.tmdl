	measure 'Show Selected Candidate Requirement Row' =
			
			VAR SelectedGroupKey =
			    [Selected Candidate Test Group Key]
			
			VAR RequirementRowGroupKey =
			    SELECTEDVALUE (
			        'Test Group Requirement'[TestGroupKey]
			    )
			
			RETURN
			IF (
			    [Candidate Detail Context Is Valid] = 1
