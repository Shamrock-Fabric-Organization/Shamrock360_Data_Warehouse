		lineageTag: 27a2f22d-08eb-44e8-b8f4-627b0a10b51b

	measure 'Selected Candidate Test Group Key' =
			
			IF (
			    [Candidate Detail Context Is Valid] = 1,
			    SELECTEDVALUE (
			        'Candidate Test Group'[TestGroupKey]
			    )
			)
