	measure 'Mapped Outcome Status' =
			
			VAR RequirementKey =
			    SELECTEDVALUE (
			        'Test Group Requirement'[RequirementKey]
			    )
			VAR SourceOutcome =
			    [Source Outcome Normalized]
			RETURN
			IF (
			    NOT ISBLANK ( RequirementKey )
			        && NOT ISBLANK ( SourceOutcome ),
			
			    CALCULATE (
			        SELECTEDVALUE (
			            'Test Group Outcome'[OutcomeStatusNormalized]
			        ),
			
			        REMOVEFILTERS (
			            'Test Group Outcome'
			        ),
			
			        TREATAS (
			            { RequirementKey },
			            'Test Group Outcome'[RequirementKey]
			        ),
			
			        TREATAS (
			            { SourceOutcome },
			            'Test Group Outcome'[OutcomeIdNormalized]
			        )
			    )
			)
		lineageTag: 3df3b9da-8a4e-4a99-a664-b23dfc84d306

	measure 'Relabel Test Status' =
			
			VAR SourceExists =
			    [Source Test Row Count] > 0
			VAR SourceSkipped =
			    [Source Test Is Skipped] = 1
			VAR SourceConflict =
			    [Source Test Conflict Flag] = 1
			
			VAR SourceClass =
			    [Source Test Class]
			VAR TargetClass =
			    SELECTEDVALUE (
			        'Test Group Requirement'[TargetTestClass]
			    )
			
			VAR TargetConflict =
			    SELECTEDVALUE (
			        'Test Group Requirement'[RequirementConflictFlag],
			        0
			    ) = 1
			
			VAR SourceUnit =
			    COALESCE ( [Source Unit Normalized], "" )
			VAR TargetUnit =
			    COALESCE (
			        SELECTEDVALUE (
			            'Test Group Requirement'[TargetUnitNormalized]
			        ),
			        ""
			    )
			
			VAR NumericResult =
			    [Source Numeric Result]
			VAR LowerLimit =
			    SELECTEDVALUE (
			        'Test Group Requirement'[lowerlimit]
			    )
			VAR UpperLimit =
			    SELECTEDVALUE (
			        'Test Group Requirement'[upperlimit]
			    )
			
			VAR HasLower =
			    NOT ISBLANK ( LowerLimit )
			VAR HasUpper =
			    NOT ISBLANK ( UpperLimit )
			
			VAR Outcome =
			    [Source Outcome Normalized]
			VAR OutcomeStatus =
			    [Mapped Outcome Status]
			
			RETURN
			SWITCH (
			    TRUE (),
			
			    [Source Selection Is Valid] <> 1, BLANK (),
			
			    NOT SourceExists, "MISSING",
			
			    SourceSkipped, "SKIPPED",
			
			    SourceConflict || TargetConflict, "REVIEW",
			
			    NOT (
			        SourceClass IN { "OPTION", "NUMERIC" }
			    ), "REVIEW",
			
			    NOT (
			        TargetClass IN { "OPTION", "NUMERIC" }
			    ), "REVIEW",
			
			    SourceClass <> TargetClass, "REVIEW",
			
			    TargetClass = "NUMERIC"
			        && SourceUnit <> TargetUnit, "REVIEW",
			
			    TargetClass = "NUMERIC"
			        && ISBLANK ( NumericResult ), "NO VALUE",
			
			    TargetClass = "NUMERIC"
			        && NOT ( HasLower || HasUpper ), "REVIEW",
			
			    TargetClass = "NUMERIC"
			        && HasLower
			        && NumericResult < LowerLimit, "FAIL",
			
			    TargetClass = "NUMERIC"
			        && HasUpper
			        && NumericResult > UpperLimit, "FAIL",
			
			    TargetClass = "NUMERIC", "PASS",
			
			    TargetClass = "OPTION"
			        && ISBLANK ( Outcome ), "NO VALUE",
			
			    TargetClass = "OPTION"
			        && OutcomeStatus = "PASS", "PASS",
			
			    TargetClass = "OPTION"
			        && OutcomeStatus = "FAIL", "FAIL",
			
			    "REVIEW"
			)
		lineageTag: fd1a23d0-2202-4148-b4af-f2b42151841c

	measure 'Passing Outcomes' =
			
			CONCATENATEX (
			    FILTER (
			        'Test Group Outcome',
			        'Test Group Outcome'[OutcomeStatusNormalized] = "PASS"
			    ),
			
			    'Test Group Outcome'[PossibleOutcomeId]
			        & IF (
			            NOT ISBLANK (
			                'Test Group Outcome'[PossibleOutcomeDescription]
			            ),
			            " - "
			                & 'Test Group Outcome'[PossibleOutcomeDescription],
			            ""
			        ),
			
			    ", ",
			
			    'Test Group Outcome'[PossibleOutcomeId],
			    ASC
			)
		lineageTag: 5e475903-d4e1-45c3-a67e-6b4c3f0e1cdd

	measure 'Target Criteria' =
			
			VAR TargetClass =
			    SELECTEDVALUE (
			        'Test Group Requirement'[TargetTestClass]
			    )
			VAR LowerLimit =
			    SELECTEDVALUE (
			        'Test Group Requirement'[lowerlimit]
			    )
			VAR UpperLimit =
			    SELECTEDVALUE (
			        'Test Group Requirement'[upperlimit]
			    )
			VAR Unit =
			    SELECTEDVALUE (
			        'Test Group Requirement'[TargetUnit]
			    )
			VAR UnitSuffix =
			    IF (
			        NOT ISBLANK ( Unit ),
			        " " & Unit,
			        ""
			    )
			RETURN
			SWITCH (
			    TRUE (),
			
			    TargetClass = "OPTION",
			        COALESCE (
			            [Passing Outcomes],
			            "No passing outcomes defined"
			        ),
			
			    TargetClass = "NUMERIC"
			        && NOT ISBLANK ( LowerLimit )
			        && NOT ISBLANK ( UpperLimit ),
			        FORMAT ( LowerLimit, "0.####" )
			            & " to "
			            & FORMAT ( UpperLimit, "0.####" )
			            & UnitSuffix,
			
			    TargetClass = "NUMERIC"
			        && NOT ISBLANK ( LowerLimit ),
			        "≥ "
			            & FORMAT ( LowerLimit, "0.####" )
			            & UnitSuffix,
			
			    TargetClass = "NUMERIC"
			        && NOT ISBLANK ( UpperLimit ),
			        "≤ "
			            & FORMAT ( UpperLimit, "0.####" )
			            & UnitSuffix,
			
			    "Review specification"
			)
		lineageTag: 13aa1f80-f997-48b6-b63b-fbd033fedd80

	measure 'Source Result Display' =
			
			VAR TargetClass =
			    SELECTEDVALUE (
			        'Test Group Requirement'[TargetTestClass]
			    )
			VAR Unit =
			    [Source Unit]
			RETURN
			SWITCH (
			    TRUE (),
			
			    [Source Test Row Count] = 0,
			        BLANK (),
			
			    [Source Test Is Skipped] = 1,
			        "Skipped",
			
			    TargetClass = "OPTION",
			        [Source Outcome],
			
			    TargetClass = "NUMERIC"
			        && NOT ISBLANK ( [Source Numeric Result] ),
			        FORMAT (
			            [Source Numeric Result],
			            "0.####"
			        )
			            & IF (
			                NOT ISBLANK ( Unit ),
			                " " & Unit,
			                ""
			            ),
			
			    BLANK ()
			)
		lineageTag: e58e2baa-23c2-48f3-bfa1-414233ca8c8c

	measure 'Test Action Required' =
			
			SWITCH (
			    [Relabel Test Status],
			
			    "PASS",
			        "No action",
			
			    "FAIL",
			        "Candidate group requirement failed",
			
			    "MISSING",
			        "Perform this required test",
			
			    "SKIPPED",
			        "Perform or validate the skipped test",
			
			    "NO VALUE",
			        "Enter or validate the test result",
			
			    "REVIEW",
			        "QC review required",
			
			    BLANK ()
			)
		lineageTag: cf20e5e9-b6f5-4758-8ee7-db25467c1ae8

