			)
		lineageTag: e1ba1cc5-1030-4182-89c7-d44297ce9355

	measure 'Selected Group Failed Test Count' =
			
			SUMX (
			    VALUES (
			        'Test Group Requirement'[RequirementKey]
			    ),
			    IF (
			        [Relabel Test Status] = "FAIL",
			        1,
			        0
			    )
			)
		formatString: 0
		lineageTag: 2b9828ac-d2c5-464a-9a12-aa6ba4d7e09c

	measure 'Selected Group Incomplete Test Count' =
			
			SUMX (
			    VALUES (
			        'Test Group Requirement'[RequirementKey]
			    ),
			    IF (
			        [Relabel Test Status]
			            IN {
			                "MISSING",
			                "SKIPPED",
			                "NO VALUE",
			                "REVIEW"
			            },
			        1,
			        0
			    )
			)
		formatString: 0
		lineageTag: 9dd66712-f99f-453a-bb9a-051405647a4a

	measure 'Selected Group Decision' =
			
			[Candidate Group Decision]
		lineageTag: 3e1f0cc7-e01a-49ce-ade6-52cb43860f7b

	measure 'Source Test Is Extra' =
			
			VAR SourceTest =
			    SELECTEDVALUE (
			        'Quality Order Test Evidence'[TestIdNormalized]
			    )
			VAR RequirementRows =
			    CALCULATE (
			        COUNTROWS (
			            'Test Group Requirement'
			        ),
			        TREATAS (
			            { SourceTest },
			            'Test Group Requirement'[TestIdNormalized]
			        )
			    )
			RETURN
			IF (
			    NOT ISBLANK ( SourceTest )
			        && RequirementRows = 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 4c5911f0-37b0-4e34-9df7-e7f7c0a46d03

	measure 'Candidate Group Selection Count' =
			
			IF (
			    [Source Selection Is Valid] = 1,
			    DISTINCTCOUNT (
			        'Candidate Test Group'[TestGroupKey]
			    )
			)
		formatString: 0
		lineageTag: 7e910680-a522-4994-8f0d-8839ef4d9f53

	measure 'Candidate Detail Context Is Valid' =
			
			IF (
			    [Source Selection Is Valid] = 1
			        && [Candidate Group Selection Count] = 1,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 85e9f099-4b48-48c7-9043-0a3859b8ac7c

	measure 'Show Action Row' =
			
			IF (
			    [Candidate Detail Context Is Valid] = 1
			        && [Relabel Test Status]
			            IN {
			                "FAIL",
			                "MISSING",
			                "SKIPPED",
			                "NO VALUE",
			                "REVIEW"
			            },
			    1,
			    0
			)
		formatString: 0
		lineageTag: 100d2ef3-1b5b-4b2f-9e6b-de80ed3e0e92

	measure 'Source Evidence Result' =
			
			VAR IsSkipped =
			    SELECTEDVALUE (
			        'Quality Order Test Evidence'[IsSkipped],
			        0
			    ) = 1
			
			VAR SourceClass =
			    SELECTEDVALUE (
			        'Quality Order Test Evidence'[SourceTestClass]
			    )
			
			VAR NumericResult =
			    MAX (
			        'Quality Order Test Evidence'[SourceNumericResult]
			    )
			
			VAR Outcome =
			    SELECTEDVALUE (
			        'Quality Order Test Evidence'[SourceOutcome]
			    )
			
			VAR Unit =
			    SELECTEDVALUE (
			        'Quality Order Test Evidence'[SourceUnit]
			    )
			
			RETURN
			SWITCH (
			    TRUE (),
			
			    IsSkipped,
			        "Skipped",
			
			    SourceClass = "OPTION",
			        Outcome,
			
			    SourceClass = "NUMERIC"
			        && NOT ISBLANK ( NumericResult ),
			        FORMAT (
			            NumericResult,
			            "0.####"
			        )
			            & IF (
			                NOT ISBLANK ( Unit ),
			                " " & Unit,
			                ""
			            ),
			
			    BLANK ()
			)
		lineageTag: 8522759b-8d7b-4d5d-878c-7252a4e41601

	measure 'Show Selected Source QC Row' =
			
			VAR SelectedQualityOrder =
			    [Source Quality Order ID]
			
			VAR SelectedLegalEntity =
			    SELECTEDVALUE (
			        'Source Quality Order'[Legal_EntityKey]
			    )
			
			VAR RowQualityOrder =
			    SELECTEDVALUE (
			        'Fact_QualityOrderLineResults'[qualityorderid]
			    )
			
			VAR RowLegalEntity =
			    SELECTEDVALUE (
			        'Fact_QualityOrderLineResults'[Legal_EntityKey]
			    )
			
			RETURN
			IF (
			    [Candidate Detail Context Is Valid] = 1
			        && RowQualityOrder = SelectedQualityOrder
			        && RowLegalEntity = SelectedLegalEntity,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 0f26572f-50e6-45e3-8110-729047998aab

	measure 'Show Selected Candidate Specification Row' =
			
			VAR SelectedTestGroupKey =
			    SELECTEDVALUE (
			        'Candidate Test Group'[TestGroupKey]
			    )
			
			VAR RowTestGroupKey =
			    SELECTEDVALUE (
			        'Fact_TestGroupDetails'[TestGroupKey]
			    )
			
			RETURN
			IF (
			    [Candidate Detail Context Is Valid] = 1
