	partition 'Quality Order Test Evidence' = m
		mode: import
		source =
				let
				  Source = Sql.Database("efrhfadk6eru3b7hpy4j3xs2eu-qg2ask2keqhepf4xm5b72jokau.datawarehouse.fabric.microsoft.com", "WH_Curated", [Query = "SELECT#(lf)    CONCAT(#(lf)        CAST(f.Legal_EntityKey AS varchar(20)),#(lf)        '|',#(lf)        f.qualityorderid#(lf)    ) AS SourceOrderKey,#(lf)#(lf)    f.Legal_EntityKey,#(lf)    f.qualityorderid,#(lf)#(lf)    UPPER(TRIM(f.testid)) AS TestIdNormalized,#(lf)    MAX(f.testid) AS testid,#(lf)    MIN(f.testsequence) AS testsequence,#(lf)#(lf)    MAX(f.TestType) AS SourceTestType,#(lf)#(lf)    CASE#(lf)        WHEN MAX(f.TestType) = 'Option'#(lf)            THEN 'OPTION'#(lf)        WHEN MAX(f.TestType) IN ('Fraction', 'Integer')#(lf)            THEN 'NUMERIC'#(lf)        ELSE 'UNSUPPORTED'#(lf)    END AS SourceTestClass,#(lf)#(lf)    MAX(f.testunitid) AS SourceUnit,#(lf)#(lf)    NULLIF(#(lf)        UPPER(TRIM(MAX(COALESCE(f.testunitid, '')))),#(lf)        ''#(lf)    ) AS SourceUnitNormalized,#(lf)#(lf)    MAX(f.qmsskiptest) AS IsSkipped,#(lf)#(lf)    MAX(f.testresultvaluereal) AS SourceNumericResult,#(lf)    MAX(f.testresultvalueoutcome) AS SourceOutcome,#(lf)#(lf)    NULLIF(#(lf)        UPPER(TRIM(MAX(COALESCE(f.testresultvalueoutcome, '')))),#(lf)        ''#(lf)    ) AS SourceOutcomeNormalized,#(lf)#(lf)    MAX(f.testresult) AS OriginalResultFlag,#(lf)    MAX(f.[testresult_$label]) AS OriginalResultLabel,#(lf)#(lf)    COUNT(*) AS SourceRowCount,#(lf)#(lf)    CASE#(lf)        WHEN COUNT(*) > 1#(lf)          OR COUNT(DISTINCT COALESCE(f.TestType, '<NULL>')) > 1#(lf)          OR COUNT(DISTINCT COALESCE(f.testunitid, '<NULL>')) > 1#(lf)        THEN 1#(lf)        ELSE 0#(lf)    END AS SourceConflictFlag#(lf)#(lf)FROM dbo.mtbl_EDW_Fact_QualityOrderLineResults AS f#(lf)#(lf)WHERE#(lf)    f.qualityorderid IS NOT NULL#(lf)    AND f.testid IS NOT NULL#(lf)#(lf)    -- Optional future size control:#(lf)    -- AND f.LineCreatedDateTime >= 'YOUR-D365-GO-LIVE-DATE'#(lf)#(lf)GROUP BY#(lf)    f.Legal_EntityKey,#(lf)    f.qualityorderid,#(lf)    UPPER(TRIM(f.testid));"])
				in
				  Source

	annotation PBI_ResultType = Table


