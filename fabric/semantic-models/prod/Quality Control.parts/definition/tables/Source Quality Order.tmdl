	partition 'Source Quality Order' = m
		mode: import
		source =
				let
				  Source = Sql.Database("efrhfadk6eru3b7hpy4j3xs2eu-qg2ask2keqhepf4xm5b72jokau.datawarehouse.fabric.microsoft.com", "WH_Curated", [Query = "SELECT#(lf)    CONCAT(#(lf)        CAST(f.Legal_EntityKey AS varchar(20)),#(lf)        '|',#(lf)        f.qualityorderid#(lf)    ) AS SourceOrderKey,#(lf)#(lf)    f.Legal_EntityKey,#(lf)    le.CMPNY,#(lf)    f.qualityorderid,#(lf)#(lf)    MAX(f.inventbatchid) AS [Batch Number],#(lf)    NULLIF(MAX(NULLIF(f.inventserialid, '')), '') AS [Serial Number],#(lf)#(lf)    MAX(p.Product_ID) AS Product_ID,#(lf)    MAX(p.Product_Name) AS Product_Name,#(lf)    MAX(p.Commercial_Name) AS [Source Commercial Name],#(lf)#(lf)    MAX(f.QuaityOrderStatus) AS QualityOrderStatus,#(lf)#(lf)    MAX(f.TestGroupKey) AS OriginalTestGroupKey,#(lf)    MAX(f.testgroupid) AS OriginalTestGroupID,#(lf)    MAX(tg.TestGroupDescription) AS OriginalTestGroupDescription,#(lf)#(lf)    MIN(f.LineCreatedDateTime) AS LineCreatedDateTime,#(lf)    MAX(f.ValidatedDateTime) AS ValidatedDateTime#(lf)#(lf)FROM dbo.mtbl_EDW_Fact_QualityOrderLineResults AS f#(lf)#(lf)LEFT JOIN dbo.mtbl_EDW_Dim_Product AS p#(lf)    ON f.ProductKey = p.ProductKey#(lf)#(lf)LEFT JOIN dbo.mtbl_EDW_Dim_Legal_Entity AS le#(lf)    ON f.Legal_EntityKey = le.Legal_EntityKey#(lf)    AND le.RecordStatus = 1#(lf)#(lf)LEFT JOIN dbo.mtbl_EDW_Dim_TestGroup AS tg#(lf)    ON f.TestGroupKey = tg.TestGroupKey#(lf)    AND tg.RecordStatus = 1#(lf)#(lf)WHERE#(lf)    f.qualityorderid IS NOT NULL#(lf)#(lf)    -- Optional future size control:#(lf)    -- AND f.LineCreatedDateTime >= 'YOUR-D365-GO-LIVE-DATE'#(lf)#(lf)GROUP BY#(lf)    f.Legal_EntityKey,#(lf)    le.CMPNY,#(lf)    f.qualityorderid;"])
				in
				  Source

	annotation PBI_ResultType = Table


