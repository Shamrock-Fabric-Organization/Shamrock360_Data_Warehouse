	partition 'Test Group Outcome' = m
		mode: import
		source =
				let
				  Source = Sql.Database("efrhfadk6eru3b7hpy4j3xs2eu-qg2ask2keqhepf4xm5b72jokau.datawarehouse.fabric.microsoft.com", "WH_Curated", [Query = "SELECT#(lf)    CONCAT(#(lf)        CAST(d.TestGroupKey AS varchar(20)),#(lf)        '|',#(lf)        UPPER(TRIM(d.testid))#(lf)    ) AS RequirementKey,#(lf)#(lf)    d.TestGroupKey,#(lf)    d.Legal_EntityKey,#(lf)    MAX(d.testgroupid) AS testgroupid,#(lf)#(lf)    UPPER(TRIM(d.testid)) AS TestIdNormalized,#(lf)    MAX(d.testid) AS testid,#(lf)#(lf)    UPPER(#(lf)        TRIM(#(lf)            CAST(d.PossibleOutcomeId AS varchar(100))#(lf)        )#(lf)    ) AS OutcomeIdNormalized,#(lf)#(lf)    MAX(d.PossibleOutcomeId) AS PossibleOutcomeId,#(lf)    MAX(d.PossibleOutcomeDescription) AS PossibleOutcomeDescription,#(lf)#(lf)    CASE#(lf)        WHEN COUNT(#(lf)                 DISTINCT UPPER(#(lf)                     TRIM(COALESCE(d.OutcomeStatus, ''))#(lf)                 )#(lf)             ) = 1#(lf)#(lf)        THEN MAX(#(lf)                 UPPER(#(lf)                     TRIM(COALESCE(d.OutcomeStatus, ''))#(lf)                 )#(lf)             )#(lf)#(lf)        ELSE 'CONFLICT'#(lf)    END AS OutcomeStatusNormalized,#(lf)#(lf)    CASE#(lf)        WHEN COUNT(#(lf)                 DISTINCT UPPER(#(lf)                     TRIM(COALESCE(d.OutcomeStatus, ''))#(lf)                 )#(lf)             ) > 1#(lf)#(lf)        THEN 1#(lf)        ELSE 0#(lf)    END AS OutcomeConflictFlag#(lf)#(lf)FROM dbo.mtbl_EDW_Fact_TestGroupDetails AS d#(lf)#(lf)INNER JOIN dbo.mtbl_EDW_Dim_TestGroup AS g#(lf)    ON d.TestGroupKey = g.TestGroupKey#(lf)    AND g.RecordStatus = 1#(lf)#(lf)WHERE#(lf)    d.TestType = 'Option'#(lf)    AND d.testid IS NOT NULL#(lf)    AND d.PossibleOutcomeId IS NOT NULL#(lf)#(lf)GROUP BY#(lf)    d.TestGroupKey,#(lf)    d.Legal_EntityKey,#(lf)    UPPER(TRIM(d.testid)),#(lf)    UPPER(#(lf)        TRIM(#(lf)            CAST(d.PossibleOutcomeId AS varchar(100))#(lf)        )#(lf)    );"])
				in
				  Source

	annotation PBI_ResultType = Exception


