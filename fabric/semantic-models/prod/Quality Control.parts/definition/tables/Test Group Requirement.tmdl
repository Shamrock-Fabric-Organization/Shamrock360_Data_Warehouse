	partition 'Test Group Requirement' = m
		mode: import
		source =
				let
				  Source = Sql.Database("efrhfadk6eru3b7hpy4j3xs2eu-qg2ask2keqhepf4xm5b72jokau.datawarehouse.fabric.microsoft.com", "WH_Curated", [Query = "SELECT#(lf)    CONCAT(#(lf)        CAST(d.TestGroupKey AS varchar(20)),#(lf)        '|',#(lf)        UPPER(TRIM(d.testid))#(lf)    ) AS RequirementKey,#(lf)#(lf)    d.TestGroupKey,#(lf)    d.Legal_EntityKey,#(lf)    MAX(d.testgroupid) AS testgroupid,#(lf)#(lf)    UPPER(TRIM(d.testid)) AS TestIdNormalized,#(lf)    MAX(d.testid) AS testid,#(lf)#(lf)    MIN(d.testsequence) AS testsequence,#(lf)    MAX(d.TestDescription) AS TestDescription,#(lf)#(lf)    MAX(d.TestType) AS TargetTestType,#(lf)#(lf)    CASE#(lf)        WHEN MAX(d.TestType) = 'Option'#(lf)            THEN 'OPTION'#(lf)        WHEN MAX(d.TestType) IN ('Fraction', 'Integer')#(lf)            THEN 'NUMERIC'#(lf)        ELSE 'UNSUPPORTED'#(lf)    END AS TargetTestClass,#(lf)#(lf)MAX(#(lf)    CASE#(lf)        WHEN d.TestType IN ('Fraction', 'Integer')#(lf)            THEN d.testunitid#(lf)        ELSE NULL#(lf)    END#(lf)) AS TargetUnit,#(lf)#(lf)NULLIF(#(lf)    UPPER(#(lf)        TRIM(#(lf)            MAX(#(lf)                CASE#(lf)                    WHEN d.TestType IN ('Fraction', 'Integer')#(lf)                        THEN d.testunitid#(lf)                    ELSE NULL#(lf)                END#(lf)            )#(lf)        )#(lf)    ),#(lf)    ''#(lf)) AS TargetUnitNormalized,#(lf)#(lf)MAX(#(lf)    CASE#(lf)        WHEN d.TestType IN ('Fraction', 'Integer')#(lf)            THEN d.lowerlimit#(lf)        ELSE NULL#(lf)    END#(lf)) AS lowerlimit,#(lf)#(lf)MAX(#(lf)    CASE#(lf)        WHEN d.TestType IN ('Fraction', 'Integer')#(lf)            THEN d.upperlimit#(lf)        ELSE NULL#(lf)    END#(lf)) AS upperlimit,#(lf)#(lf)    MAX(d.ActionOnFailure) AS ActionOnFailure,#(lf)    MAX(d.CertificateOfAnalysis) AS CertificateOfAnalysis,#(lf)#(lf)    CASE#(lf)    WHEN COUNT(#(lf)             DISTINCT COALESCE(d.TestType, '<NULL>')#(lf)         ) > 1#(lf)#(lf)      OR COUNT(#(lf)             DISTINCT CASE#(lf)                 WHEN d.TestType IN ('Fraction', 'Integer')#(lf)                     THEN COALESCE(d.testunitid, '<NULL>')#(lf)                 ELSE NULL#(lf)             END#(lf)         ) > 1#(lf)#(lf)      OR COUNT(#(lf)             DISTINCT CASE#(lf)                 WHEN d.TestType IN ('Fraction', 'Integer')#(lf)                     THEN COALESCE(#(lf)                         CAST(d.lowerlimit AS varchar(100)),#(lf)                         '<NULL>'#(lf)                     )#(lf)                 ELSE NULL#(lf)             END#(lf)         ) > 1#(lf)#(lf)      OR COUNT(#(lf)             DISTINCT CASE#(lf)                 WHEN d.TestType IN ('Fraction', 'Integer')#(lf)                     THEN COALESCE(#(lf)                         CAST(d.upperlimit AS varchar(100)),#(lf)                         '<NULL>'#(lf)                     )#(lf)                 ELSE NULL#(lf)             END#(lf)         ) > 1#(lf)#(lf)    THEN 1#(lf)    ELSE 0#(lf)END AS RequirementConflictFlag#(lf)#(lf)FROM dbo.mtbl_EDW_Fact_TestGroupDetails AS d#(lf)#(lf)INNER JOIN dbo.mtbl_EDW_Dim_TestGroup AS g#(lf)    ON d.TestGroupKey = g.TestGroupKey#(lf)    AND g.RecordStatus = 1#(lf)#(lf)WHERE#(lf)    d.testid IS NOT NULL#(lf)#(lf)    -- If Fact_TestGroupDetails later receives RecordStatus:#(lf)    -- AND d.RecordStatus = 1#(lf)#(lf)GROUP BY#(lf)    d.TestGroupKey,#(lf)    d.Legal_EntityKey,#(lf)    UPPER(TRIM(d.testid));"])
				in
				  Source

	annotation PBI_ResultType = Exception


