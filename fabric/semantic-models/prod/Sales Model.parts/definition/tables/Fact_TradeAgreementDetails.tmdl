table Fact_TradeAgreementDetails
	lineageTag: f6e44455-0201-4820-b0df-6de997392b96
	sourceLineageTag: [dbo].[mtbl_EDW_Fact_TradeAgreementDetails]

	measure 'Total Orders & TA' =
			
			COUNTROWS ( Fact_Sales )
			    + COUNTROWS ( Fact_TradeAgreementDetails )
		formatString: 0
		lineageTag: d790482e-5ec8-4c5c-b070-749ba6db32ae

		changedProperty = Name

	measure 'Total TA' = COUNTROWS ( Fact_TradeAgreementDetails )
		formatString: 0
		lineageTag: 58cc9443-a46d-421c-837c-9150bb1d531a

		changedProperty = Name

	measure 'TA Price' =
			
			VAR PriceCount =
			    DISTINCTCOUNT ( 'Fact_TradeAgreementDetails'[Price] )
			VAR LineCount =
			    COUNTROWS ( 'Fact_TradeAgreementDetails' )
			RETURN
			    SWITCH (
			        TRUE(),
			        LineCount = 0, BLANK(),
			        PriceCount = 1, MAX ( 'Fact_TradeAgreementDetails'[Price] ),
			        BLANK()
			    )
		lineageTag: ba4ffff3-c582-4cf3-a0b6-b47d2e4d04bd

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

