table 'Sales Measures'
	lineageTag: 221a0c4b-a5d1-4e8d-9e53-cb8238a4a525

	measure 'Base Sales Price Per LB Display' =
			
			VAR _OneProduct =
			    HASONEVALUE ( 'Dim_Product'[Product_ID] )
			
			VAR _Weight =
			    [Selected Display Weight]
			
			VAR _BaseSalesPrice =
			    SWITCH (
			        _Weight,
			        "LBs", SELECTEDVALUE ( 'Dim_Product'[BaseSalesPricePerLB] ),
			        "KGs", SELECTEDVALUE ( 'Dim_Product'[BaseSalesPricePerKG] ),
			        BLANK ()
			    )
			
			VAR _Locale =
			    USERCULTURE ()
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        NOT _OneProduct,
			            "Select a product",
			
			        NOT ( _Weight IN { "LBs", "KGs" } ),
			            "Select LBs or KGs",
			
			        ISBLANK ( _BaseSalesPrice ),
			            "No base price",
			
			        FORMAT (
			            _BaseSalesPrice,
			            "#,##0.00",
			            _Locale
			        )
			    )
		lineageTag: fb669bd0-5d9b-46f0-9087-54334f515622

	measure 'Base Price ($/LB)' = ```
			
			VAR BasePrice =
			    SELECTEDVALUE ( 'Dim_Product'[BaseSalesPricePerLB] )
			RETURN
			    IF (
			        NOT ISBLANK ( [TA Price] ),
			        BasePrice
			    )
			
			```
		lineageTag: 3e1b558f-a56e-4b65-9dd9-153e7bcba33e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TA vs Base Difference' = ```
			
			VAR TAPrice = [TA Price]
			VAR BasePrice = [Base Price ($/LB)]
			RETURN
			    IF (
			        NOT ISBLANK ( TAPrice )
			            && NOT ISBLANK ( BasePrice ),
			        TAPrice - BasePrice
			    )
			
			```
		lineageTag: 0bbfb12d-7070-449e-bd6a-84364e8b3844

		annotation PBI_FormatHint = {"isGeneralNumber":true}

