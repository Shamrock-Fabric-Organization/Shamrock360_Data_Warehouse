table Dim_Address
	lineageTag: 3b06c9a6-8047-41a3-92c0-4362398156e3
	sourceLineageTag: [dbo].[mtbl_EDW_Dim_Address]

	measure 'CPCID State' = ```
			
			VAR StateCount =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Dim_Address'[State] ),
			        ALLEXCEPT ( 'Fact_Sales', 'Fact_Sales'[CPCID] )
			    )
			VAR SingleState =
			    CALCULATE (
			        SELECTEDVALUE ( 'Dim_Address'[State] ),
			        ALLEXCEPT ( 'Fact_Sales', 'Fact_Sales'[CPCID] )
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        StateCount = 0, BLANK (),
			        StateCount = 1, SingleState,
			        "Multiple"
			    )
			
			```
		lineageTag: d3af780d-e3d0-464a-a83f-7f396742f554

		changedProperty = Name

