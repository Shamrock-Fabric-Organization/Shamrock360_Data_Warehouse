	/// Returns "Yes" when Is_CoProduct = 1 and "No" when Is_CoProduct = 0; otherwise BLANK.
	measure 'Is CoProduct (Yes/No)' =
			VAR _flag = SELECTEDVALUE('Fact_ProductionBatchOrderVariance'[Is_CoProduct])
			RETURN
			SWITCH(TRUE(),
			    _flag = 1, "Yes",
			    _flag = 0, "No",
			    BLANK()
			)
		formatString: @
		lineageTag: f4a6e2ee-b936-4385-b58e-6587fdee7151

