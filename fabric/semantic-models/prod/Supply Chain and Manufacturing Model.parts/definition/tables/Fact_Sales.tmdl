table Fact_Sales
	lineageTag: 8ef0c381-7148-416b-a875-dba48c51ed72
	sourceLineageTag: [dbo].[mtbl_EDW_Fact_Sales]

	measure 'Quantity LBs' = SUM(Fact_Sales[Quantity_LBs])
		lineageTag: 1589cd52-568e-450b-b80d-8b214ec8b66e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' = COUNTROWS(Fact_Sales)
		formatString: 0
		lineageTag: 372dfe81-7ea1-4b78-b957-88b9343aa05f

		changedProperty = Name

	measure 'Sales Amount' = SUM(Fact_Sales[Amount])
		lineageTag: 40b6dc1c-a4ef-4bfa-a722-a6153aaa3460

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SalesPricePerLB = Divide([Sales Amount] , [Quantity LBs])
		lineageTag: d798d8ee-a485-4fd9-81bd-c8ef926d53ef

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Date' =
			
			VAR _OrderDateKey =
			    SELECTEDVALUE ( 'Fact_Sales'[OrderDateKey] )
			RETURN
			    IF (
			        ISBLANK ( _OrderDateKey ),
			        BLANK (),
			        CALCULATE (
			            SELECTEDVALUE ( 'Dim_Date'[Date] ),
			            REMOVEFILTERS ( 'Dim_Date' ),
			            TREATAS (
			                { _OrderDateKey },
			                'Dim_Date'[DateKey]
			            )
			        )
			    )
		formatString: General Date
		lineageTag: 5c3cfbef-462a-4b6b-a639-94fa8e5d16cd

		changedProperty = Name

	measure 'Invoiced Sales Amount' = SUM(Fact_Sales[InvoiceLineAmount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3c345489-3da0-4b0e-a09a-ca61693009de

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Invoiced Quantity' = SUM(Fact_Sales[InvoiceQuantity_LBs])
		formatString: #,0.00
		lineageTag: 2fa9fc6d-3cc2-4789-a95b-46f449b20f0b

		changedProperty = Name

		changedProperty = FormatString

