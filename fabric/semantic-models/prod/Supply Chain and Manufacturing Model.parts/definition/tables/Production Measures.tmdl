	measure 'UI Unproductive Qty (Single Date)' =
			
			VAR SnapshotDate =
			    SELECTEDVALUE ( 'Dim_Date'[Date] )
			
			RETURN
			    IF (
			        ISBLANK ( SnapshotDate ),
			        BLANK (),
			
			        VAR NonOffSpecStatuses =
			            FILTER (
			                VALUES (
			                    'Fact_Inventory_Snapshot_Extended'[inventstatusid]
			                ),
			                NOT (
			                    UPPER (
			                        TRIM (
			                            COALESCE (
			                                'Fact_Inventory_Snapshot_Extended'[inventstatusid],
			                                ""
			                            )
			                        )
			                    ) IN {
			                        "BLOCKED",
			                        "REWORK",
			                        "NC",
			                        "EXPIRED-BL"
			                    }
			                )
			            )
			
			        VAR AgedOutsideOffSpec =
			            CALCULATE (
			                [UI Aged Qty (Single Date)],
			                KEEPFILTERS ( NonOffSpecStatuses )
			            )
			
			        RETURN
			            [UI Off-Spec Qty (Single Date)]
			                + AgedOutsideOffSpec
			    )
		lineageTag: 17e983f1-9055-4470-8fed-9367efbaa7f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'UI Unproductive Qty' =
			
			VAR SnapshotDate =
			    [UI Snapshot Date]
			
			VAR SelectedView =
			    [UI Selected View]
			
			RETURN
			    IF (
			        ISBLANK ( SnapshotDate )
			            || ISBLANK ( SelectedView ),
			        BLANK (),
			
			        CALCULATE (
			            SWITCH (
			                SelectedView,
			
			                "Aged",
			                    [UI Aged Qty (Single Date)],
			
			                "Off-Spec",
			                    [UI Off-Spec Qty (Single Date)],
			
			                "All",
			                    [UI Unproductive Qty (Single Date)],
			
			                BLANK ()
			            ),
			            REMOVEFILTERS ( 'Dim_Date' ),
			            TREATAS (
			                { SnapshotDate },
			                'Dim_Date'[Date]
			            )
			        )
			    )
		lineageTag: 1cb01a0b-1065-40a5-b2c6-514ac3700490

		annotation PBI_FormatHint = {"isGeneralNumber":true}

