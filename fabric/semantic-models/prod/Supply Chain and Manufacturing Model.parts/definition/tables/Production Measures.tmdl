			                        'Fact_Inventory_Snapshot_Extended'[inventstatusid]
			                    ),
			                    UPPER (
			                        TRIM (
			                            COALESCE (
			                                'Fact_Inventory_Snapshot_Extended'[inventstatusid],
			                                ""
