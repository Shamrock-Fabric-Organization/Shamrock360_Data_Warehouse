	measure 'UI Scoped Physical Qty' =
			
			CALCULATE (
			    [UI Physical Qty (Batch Checked)],
			
			    KEEPFILTERS (
			        FILTER (
			            VALUES ( 'Dim_Product'[itemgroupid] ),
			
			            TRIM (
			                COALESCE (
			                    'Dim_Product'[itemgroupid],
			                    ""
			                )
			            ) IN { "10", "20", "30" }
			        )
			    )
			)
		lineageTag: 8a757fde-2bab-48d2-b9b7-3ad97937c4d6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'UI Aged Qty (Single Date)' =
			
			VAR SnapshotDate =
			    SELECTEDVALUE ( 'Dim_Date'[Date] )
			
			RETURN
			    IF (
			        NOT ISBLANK ( SnapshotDate ),
			
			        VAR SixMonthCutoff =
			            EDATE ( SnapshotDate, -6 )
			
			        VAR TwelveMonthCutoff =
			            EDATE ( SnapshotDate, -12 )
			
			        VAR InScopeItemGroups =
			            FILTER (
			                VALUES ( 'Dim_Product'[itemgroupid] ),
			
			                TRIM (
			                    COALESCE (
			                        'Dim_Product'[itemgroupid],
			                        ""
			                    )
			                ) IN { "10", "20", "30" }
			            )
			
			        VAR ProductBatchGroups =
			            CALCULATETABLE (
			                SUMMARIZE (
			                    'Fact_Inventory_Snapshot_Extended',
			
			                    'Fact_Inventory_Snapshot_Extended'[CMPNY],
			                    'Fact_Inventory_Snapshot_Extended'[Product_ID],
			                    'Fact_Inventory_Snapshot_Extended'[inventbatchid],
			
			                    'Dim_Product'[itemgroupid]
			                ),
			
			                KEEPFILTERS ( InScopeItemGroups )
			            )
			
			        VAR AgedGroups =
			            FILTER (
			                ProductBatchGroups,
			
			                VAR ItemGroup =
			                    TRIM (
			                        COALESCE (
			                            'Dim_Product'[itemgroupid],
			                            ""
			                        )
			                    )
			
			                VAR MfgDate =
			                    CALCULATE (
			                        [UI Matched Mfg Date (Helper)]
			                    )
			
			                VAR AgeCutoff =
			                    IF (
			                        ItemGroup = "30",
			                        SixMonthCutoff,
			                        TwelveMonthCutoff
			                    )
			
			                RETURN
			                    NOT ISBLANK ( MfgDate )
			                        && MfgDate < AgeCutoff
			            )
			
			        RETURN
			            CALCULATE (
			                [UI Scoped Physical Qty],
			
			                KEEPFILTERS ( AgedGroups )
			            )
			    )
		lineageTag: 06812ccc-b829-45e1-b8ad-032a743df35a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'UI Off-Spec Qty (Single Date)' =
			
