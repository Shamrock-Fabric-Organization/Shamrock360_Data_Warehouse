			                        "BLOCKED",
			                        "REWORK",
			                        "NC",
			                        "EXPIRED-BL"
			                    }
			                )
			            )
			        )
			    )
		lineageTag: 0b22b68b-ff50-40e9-8657-4033c5f711c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'UI Matched Mfg Date (Helper)' =
			
			VAR CompanyCode =
			    SELECTEDVALUE (
			        'Fact_Inventory_Snapshot_Extended'[CMPNY]
			    )
			VAR ProductCode =
			    SELECTEDVALUE (
			        'Fact_Inventory_Snapshot_Extended'[Product_ID]
			    )
			VAR BatchCode =
			    SELECTEDVALUE (
			        'Fact_Inventory_Snapshot_Extended'[inventbatchid]
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( CompanyCode )
			            && CompanyCode <> ""
			            && NOT ISBLANK ( ProductCode )
			            && ProductCode <> ""
			            && NOT ISBLANK ( BatchCode )
			            && BatchCode <> "",
			
			        CALCULATE (
			            SELECTEDVALUE (
			                'Dim_Batch'[ProductionDate]
			            ),
			
			            REMOVEFILTERS ( 'Dim_Batch' ),
			
			            TREATAS (
			                { ( CompanyCode, ProductCode, BatchCode ) },
			                'Dim_Batch'[CMPNY],
			                'Dim_Batch'[ProductID],
			                'Dim_Batch'[BatchID]
			            )
			        )
			    )
		formatString: General Date
		lineageTag: f9dcda4a-2c52-47d7-bd86-80e91b0eb2ae

	measure 'UI Matched Mfg Date' =
			
			VAR SnapshotDate =
			    [UI Snapshot Date]
			
			RETURN
			    IF (
			        ISINSCOPE (
			            'Fact_Inventory_Snapshot_Extended'[inventbatchid]
			        )
			            && NOT ISBLANK ( SnapshotDate ),
			
			        CALCULATE (
			            [UI Matched Mfg Date (Helper)],
			
			            REMOVEFILTERS ( 'Dim_Date' ),
			
			            TREATAS (
			                { SnapshotDate },
			                'Dim_Date'[Date]
			            )
			        )
			    )
		formatString: General Date
		lineageTag: 4d19f99f-986a-4d72-8147-e1e0b13a8164

	measure 'UI Physical Qty (Batch Checked)' =
			
			VAR StockByIdentity =
			    SUMMARIZE (
			        'Fact_Inventory_Snapshot_Extended',
			
			        'Fact_Inventory_Snapshot_Extended'[CMPNY],
			        'Fact_Inventory_Snapshot_Extended'[Product_ID],
			        'Fact_Inventory_Snapshot_Extended'[inventbatchid],
			
			        'Dim_Batch'[CMPNY],
			        'Dim_Batch'[ProductID],
			        'Dim_Batch'[BatchID],
			
			        "@PhysicalQty",
			            SUM (
			                'Fact_Inventory_Snapshot_Extended'[physicalinvent_LBs]
			            )
			    )
			
			RETURN
			    SUMX (
			        FILTER (
			            StockByIdentity,
			
			            VAR StockCompany =
			                TRIM (
			                    COALESCE (
			                        'Fact_Inventory_Snapshot_Extended'[CMPNY],
			                        ""
			                    )
			                )
			
			            VAR StockProduct =
			                TRIM (
			                    COALESCE (
			                        'Fact_Inventory_Snapshot_Extended'[Product_ID],
			                        ""
			                    )
			                )
			
			            VAR StockBatch =
			                TRIM (
			                    COALESCE (
			                        'Fact_Inventory_Snapshot_Extended'[inventbatchid],
			                        ""
			                    )
			                )
			
			            VAR LinkedCompany =
			                TRIM (
			                    COALESCE (
			                        'Dim_Batch'[CMPNY],
			                        ""
			                    )
			                )
			
			            VAR LinkedProduct =
			                TRIM (
			                    COALESCE (
			                        'Dim_Batch'[ProductID],
			                        ""
			                    )
			                )
			
			            VAR LinkedBatch =
			                TRIM (
			                    COALESCE (
			                        'Dim_Batch'[BatchID],
			                        ""
			                    )
			                )
			
			            VAR IdentityCanBeChecked =
			                StockCompany <> ""
			                    && StockProduct <> ""
			                    && StockBatch <> ""
			                    && LinkedCompany <> ""
			                    && LinkedProduct <> ""
			                    && LinkedBatch <> ""
			
			            VAR IdentityMatches =
			                StockCompany = LinkedCompany
			                    && StockProduct = LinkedProduct
			                    && StockBatch = LinkedBatch
			
			            RETURN
			                NOT ( IdentityCanBeChecked )
			                    || IdentityMatches
			        ),
			
			        [@PhysicalQty]
			    )
		lineageTag: 60788177-271f-4a65-b9e5-f3ee853a3878

		annotation PBI_FormatHint = {"isGeneralNumber":true}

